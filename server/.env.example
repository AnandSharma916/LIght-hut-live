# ==============================================================================
# LightHut Server Configuration
# ==============================================================================

PORT=5000
NODE_ENV=development

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/lighthut?retryWrites=true&w=majority
# Example Local MongoDB URI:
# MONGODB_URI=mongodb://127.0.0.1:27017/lighthut
# If left empty in development, an embedded in-memory MongoDB instance will automatically start for instant testing.
MONGODB_URI=

# JWT Secret & Cookie Configuration
JWT_SECRET=lighthut_super_secret_jwt_key_2026_luxury_lighting_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (used by: npm run seed / npm run seed:admin)
ADMIN_NAME="LightHut Administrator"
ADMIN_EMAIL=admin@lighthut.com
ADMIN_PASSWORD=admin123456

# Cloudinary Storage (Optional - falls back to local /uploads if not set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
