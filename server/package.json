{
  "name": "lighthut-server",
  "version": "1.0.0",
  "description": "Production REST API for Light Hut Premium Lighting Catalog",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "build": "node --check server.js",
    "test": "node --check server.js",
    "dev": "node --watch --watch-path=server.js --watch-path=config --watch-path=controllers --watch-path=models --watch-path=routes --watch-path=middleware server.js",
    "seed": "node scripts/seedData.js",
    "seed:admin": "node scripts/seedAdmin.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.2.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "slugify": "^1.6.6"
  },
  "devDependencies": {
    "mongodb-memory-server": "^9.4.0"
  }
}
