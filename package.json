{
  "name": "niceadmin-lighthut-root",
  "version": "1.0.0",
  "description": "LightHut Luxury Architectural Lighting Catalog & Admin Management System",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --prefix client run build",
    "build:client": "npm --prefix client run build",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "start:server": "npm --prefix server start",
    "seed": "npm --prefix server run seed",
    "seed:admin": "npm --prefix server run seed:admin"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
